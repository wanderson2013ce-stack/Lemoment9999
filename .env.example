# Porta local do servidor
PORT=3000

# URL pública onde este backend vai estar hospedado (sem barra no final).
# É pra essa URL que o QR code e o link do convite apontam, e é o endereço
# que a Z-API precisa acessar pra buscar a imagem do QR.
# Ex: https://portaria.lemoment.com.br
BASE_URL=http://localhost:3000

# Credenciais da Z-API (painel da sua conta em app.z-api.io)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
